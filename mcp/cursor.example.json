{
  "mcpServers": {
    "ubersuggest": {
      "type": "http",
      "url": "https://ubersuggest-mcp.neilpatel.com/mcp"
    },
    "spyfu": {
      "command": "npx",
      "args": ["-y", "<spyfu-mcp-package>"],
      "env": {
        "SPYFU_API_KEY": "${SPYFU_API_KEY}"
      }
    },
    "mangools": {
      "command": "<mangools-mcp-command>",
      "args": ["<mangools-mcp-args>"],
      "env": {
        "MANGOOLS_API_TOKEN": "${MANGOOLS_API_TOKEN}"
      }
    }
  }
}
