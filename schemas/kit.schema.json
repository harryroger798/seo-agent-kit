{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/kit.schema.json",
  "title": "SEO Agent Kit manifest",
  "type": "object",
  "required": ["name", "version", "description", "entrypoints", "capabilities", "tools", "paths"],
  "properties": {
    "name": { "type": "string" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "license": {
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "content": { "type": "string" }
      }
    },
    "entrypoints": {
      "type": "object",
      "required": ["human", "agent", "manifest"],
      "additionalProperties": { "type": "string" }
    },
    "intake": {
      "type": "object",
      "properties": {
        "questions": { "type": "array", "items": { "type": "string" } },
        "checkpoints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "inputs", "outputs"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "skill": { "type": "string" },
          "prompt": { "type": "string" },
          "prompts": { "type": "array", "items": { "type": "string" } },
          "playbook": { "type": "string" },
          "checklist": { "type": "string" },
          "inputs": { "type": "array", "items": { "type": "string" } },
          "outputs": { "type": "array", "items": { "type": "string" } },
          "requires": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "connection", "auth", "fallback"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "connection": { "type": "string" },
          "auth": { "type": "string" },
          "fallback": { "type": "string" },
          "docs": { "type": "string" }
        }
      }
    },
    "rules": { "type": "array", "items": { "type": "string" } },
    "paths": { "type": "object", "additionalProperties": { "type": "string" } },
    "scripts": { "type": "object", "additionalProperties": { "type": "string" } }
  }
}
