# Copy to .env and fill only what you use.
# Never commit .env.

# Ubersuggest — prefer the official MCP connector.
# UBERSUGGEST_MCP_URL=https://ubersuggest-mcp.neilpatel.com/mcp

# AnswerThePublic
ATP_API_KEY=
ATP_API_BASE=https://api.answerthepublic.com

# SpyFu
SPYFU_API_KEY=
SPYFU_API_BASE=https://api.spyfu.com

# Mangools
MANGOOLS_API_TOKEN=
MANGOOLS_API_BASE=https://api.mangools.com

# Google Search Console / GA4
GOOGLE_APPLICATION_CREDENTIALS=
GA4_PROPERTY_ID=

# Optional
DEFAULT_COUNTRY=IN
DEFAULT_LANGUAGE=en
CURRENT_YEAR=2026
